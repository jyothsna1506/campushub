# ==============================================================================
# CampusHub Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit actual credentials, passwords, or production secrets to Git.

# --- Backend Configuration (Spring Boot) ---
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/campushub
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
JWT_SECRET=your_base64_or_256bit_secure_random_jwt_secret_key_here
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_FULL_NAME=Campus Administrator
ADMIN_BOOTSTRAP_ENABLED=true
DDL_AUTO=update
SHOW_SQL=false

# --- Frontend Configuration (Vite React) ---
VITE_API_BASE_URL=http://localhost:8080
